        ],
        "INFOPLIST_FILE": "CypherAir-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "CypherAir X",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace": "YES",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "CypherAir X uses Face ID to protect your secret keys.",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 CypherAir",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LIBRARY_SEARCH_PATHS": "$(inherited)",
        "MACOSX_DEPLOYMENT_TARGET": "27.2",
        "MARKETING_VERSION": "1.7.0",
        "OTHER_CFLAGS": [
          "$(inherited)",
          "-fmodule-map-file=$(PROJECT_DIR)/bindings/module.modulemap",
        ],
        "OTHER_LDFLAGS": "$(inherited)",
        "OTHER_SWIFT_FLAGS": "$(inherited) -Xcc -fmodule-map-file=$(PROJECT_DIR)/bindings/module.modulemap",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.chentianren.cypherair",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "iphoneos",
        "SOURCE_COMPLIANCE_REQUIRE_STABLE_RELEASE[config=AppStore Candidate Release]": "YES",
        "SOURCE_COMPLIANCE_REQUIRE_STABLE_RELEASE[config=Debug]": "NO",
        "SOURCE_COMPLIANCE_REQUIRE_STABLE_RELEASE[config=Release]": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_INCLUDE_PATHS": "$(inherited) $(PROJECT_DIR)/bindings",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
    }, {
      "name": "CypherAirTests",
      "id": "8561964DF0A7E2575A3799D6",
      "product": "Products/CypherAirTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "CypherAir",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Tests/FixtureResources.xcfilelist",
          ],
          "input-file-list-paths": [
            "$(SRCROOT)/Tests/FixtureResources.xcfilelist",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Fixtures",
          ],
          "output-file-list-paths": [
            "$(SRCROOT)/Tests/FixtureResources.outputs.xcfilelist",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "",
            "FIXTURE_LIST=\"${SRCROOT}/Tests/FixtureResources.xcfilelist\"",
            "FIXTURE_DST=\"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/Fixtures\"",
            "mkdir -p \"$FIXTURE_DST\"",
            "",
            "resolve_fixture_path() {",
            "    case \"$1\" in",
            "        \"\\$(SRCROOT)\"/*)",
            "            printf '%s/%s\\n' \"$SRCROOT\" \"${1#\"\\$(SRCROOT)/\"}\"",
            "            ;;",
            "        *)",
            "            printf '%s\\n' \"$1\"",
            "            ;;",
            "    esac",
            "}",
            "",
            "copied=0",
            "copy_fixture() {",
            "    fixture=\"$(resolve_fixture_path \"$1\")\"",
            "    case \"$fixture\" in",
            "        *.asc|*.gpg|*.sig|*.txt)",
            "            cp \"$fixture\" \"$FIXTURE_DST/\"",
            "            copied=$((copied + 1))",
            "            ;;",
            "    esac",
            "}",
            "",
            "index=0",
            "while [ \"$index\" -lt \"${SCRIPT_INPUT_FILE_COUNT:-0}\" ]; do",
            "    eval \"input_path=\\${SCRIPT_INPUT_FILE_$index}\"",
            "    copy_fixture \"$input_path\"",
            "    index=$((index + 1))",
            "done",
            "",
            "if [ \"$copied\" -eq 0 ]; then",
            "    while IFS= read -r input_path; do",
            "        [ -n \"$input_path\" ] && copy_fixture \"$input_path\"",
            "    done < \"$FIXTURE_LIST\"",
            "fi",
            "",
          ],
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "DEVELOPMENT_TEAM": "7P9PPXP2SF",
        "ENABLE_HARDWARE_CHECKED_POINTER_ARITHMETIC_SLICE": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": [
