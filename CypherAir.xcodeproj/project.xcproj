{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/CypherVault",
    },
  ],
  "files": [
    { "path": "Assets.xcassets", "target-membership": [ "CypherAir/resources" ] },
    { "path": "CypherAir.entitlements" },
    { "path": "CypherAirMacOS.entitlements" },
    { "path": "AppIcon.icon", "target-membership": [ "CypherAir/resources" ] },
    { "path": "CypherAir-Info.plist" },
    { "kind": "folder", "path": "App", "target-membership": [ "CypherAir" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/CypherAir.app", "id": "9379668011500E781695A4AC", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "CypherAir",
      "id": "8054D4FD1FA30AED22F9BF1B",
      "product": "Products/CypherAir.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "Stores",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Vault",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "$(ARCHS_STANDARD)",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_APPICON_NAME[sdk=*]": "AppIcon",
        "ASSETCATALOG_COMPILER_APPICON_NAME[sdk=xr*]": "VisionAppIconB",
        "CLANG_WARN_COMPLETION_HANDLER_MISUSE": "YES",
        "CLANG_WARN_OBJC_MISSING_PROPERTY_SYNTHESIS": "YES",
        "CODE_SIGN_ENTITLEMENTS[sdk=*]": "CypherAir.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "CypherAirMacOS.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "20000",
        "DEVELOPMENT_TEAM": "7P9PPXP2SF",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_CPLUSPLUS_BOUNDS_SAFE_BUFFERS": "YES",
        "ENABLE_C_BOUNDS_SAFETY": "YES",
        "ENABLE_ENHANCED_SECURITY": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_HARDWARE_CHECKED_POINTER_ARITHMETIC_SLICE": "YES",
        "ENABLE_POINTER_AUTHENTICATION": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GCC_NO_COMMON_BLOCKS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "CypherAir-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "CypherAir X",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2026 CypherAir",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "27.2",
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.chentianren.cypherair",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "$(ARCHS_STANDARD)",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++23",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "CypherAirMacOS.entitlements",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "7P9PPXP2SF",
    "ENABLE_CPLUSPLUS_BOUNDS_SAFE_BUFFERS": "YES",
    "ENABLE_C_BOUNDS_SAFETY": "YES",
    "ENABLE_ENHANCED_SECURITY": "YES",
    "ENABLE_HARDWARE_CHECKED_POINTER_ARITHMETIC_SLICE": "YES",
    "ENABLE_NS_ASSERTIONS[config=Debug]": "YES",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_POINTER_AUTHENTICATION": "YES",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "EXCLUDED_ARCHS": "x86_64",
    "GCC_C_LANGUAGE_STANDARD": "gnu23",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
    "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.1",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SUPPORTED_PLATFORMS": "iphonesimulator iphoneos macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_STRICT_CONCURRENCY": "complete",
    "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
    "SWIFT_VERSION": "6.0",
  },
  "last-upgrade": "27.1",
}
