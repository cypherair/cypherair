          "$(PROJECT_DIR)/bindings",
        ],
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "27.2",
        "OTHER_CFLAGS": [
          "$(inherited)",
          "-fmodule-map-file=$(PROJECT_DIR)/bindings/module.modulemap",
        ],
        "OTHER_SWIFT_FLAGS": "$(inherited) -Xcc -fmodule-map-file=$(PROJECT_DIR)/bindings/module.modulemap",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.chentianren.cypherair.tests",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_INCLUDE_PATHS": "$(inherited) $(PROJECT_DIR)/bindings",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/CypherAir.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/CypherAir",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
