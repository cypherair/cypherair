  "targets": [
    {
      "name": "CypherAir",
      "id": "8054D4FD1FA30AED22F9BF1B",
      "product": "Products/CypherAir.app",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Check PgpMobile XCFramework",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/PgpMobile.xcframework/Info.plist",
            "$(SRCROOT)/PgpMobile.xcframework/cypherair-source-fingerprint.json",
            "$(SRCROOT)/PgpMobileSourceInputs.xcfilelist",
            "$(SRCROOT)/scripts/xcframework_source_fingerprint.py",
          ],
          "input-file-list-paths": [
            "$(SRCROOT)/PgpMobileSourceInputs.xcfilelist",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ ! -f \"${SRCROOT}/PgpMobile.xcframework/Info.plist\" ]; then",
            "    echo \"error: PgpMobile.xcframework is missing. Run ./build-xcframework.sh --release\"",
            "    exit 1",
            "fi",
            "",
            "python3 \"${SRCROOT}/scripts/xcframework_source_fingerprint.py\" --check --repo-root \"${SRCROOT}\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Generate Source Compliance Info",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/generate_source_compliance_build_phase.sh",
            "$(SRCROOT)/scripts/generate_source_compliance_info.py",
            "$(SRCROOT)/pgp-mobile/Cargo.lock",
            "$(TARGET_TEMP_DIR)/SourceComplianceOverrides.json",
            "$(SRCROOT)/.git/HEAD",
            "$(SRCROOT)/.git/logs/HEAD",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/SourceComplianceInfo.json",
          ],
          "shell": "/bin/sh",
          "script": "bash \"${SRCROOT}/scripts/generate_source_compliance_build_phase.sh\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "script",
          "name": "Sync Settings Bundle Version",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/Settings.bundle/Root.plist",
            "$(SRCROOT)/Settings.bundle/en.lproj/Acknowledgements.strings",
            "$(SRCROOT)/Settings.bundle/en.lproj/Root.strings",
            "$(SRCROOT)/Settings.bundle/zh-Hans.lproj/Acknowledgements.strings",
            "$(SRCROOT)/Settings.bundle/zh-Hans.lproj/Root.strings",
            "$(SRCROOT)/Sources/Resources/OpenSourceNotices/open_source_notices.json",
            "$(SRCROOT)/scripts/sync_settings_bundle.py",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/Acknowledgements.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/Root.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/en.lproj/Acknowledgements.strings",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/en.lproj/Root.strings",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/zh-Hans.lproj/Acknowledgements.strings",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/Settings.bundle/zh-Hans.lproj/Root.strings",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "python3 \"${SRCROOT}/scripts/sync_settings_bundle.py\"\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "Stores",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Vault",
          "build-phase": { "build-phase": "frameworks" },
